{% doc %}
  @prompt
    Explore our collection section with sub-heading, black and gold heading, and black collection card titles
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

<style>
  .ai-dome-cards-{{ ai_gen_id }} { display: block; width: 100%; max-width: 100%; padding: {{ block.settings.section_padding }}px 0; color: {{ block.settings.text_color }}; background-color: {{ block.settings.section_background }}; }
  .ai-dome-cards-{{ ai_gen_id }}__inner { width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin: 0 auto; }
  .ai-dome-cards-{{ ai_gen_id }}__header { margin-bottom: 28px; text-align: {{ block.settings.heading_alignment }}; }
  .ai-dome-cards-{{ ai_gen_id }}__subheading { font-family: 'Outfit', sans-serif; font-size: 0.95rem; font-weight: 500; letter-spacing: 0.05em; color: #000000; margin-bottom: 6px; text-transform: capitalize; }
  .ai-dome-cards-{{ ai_gen_id }}__heading { margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-size: {{ block.settings.heading_size }}px; line-height: 1.25; font-weight: 700; color: #000000; }
  .ai-dome-cards-{{ ai_gen_id }}__heading span.gold-text { color: #b88146; }
  .ai-dome-cards-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: {{ block.settings.card_gap }}px; }
  .ai-dome-card-{{ ai_gen_id }} { min-width: 0; overflow: hidden; background: {{ block.settings.card_background }}; border-radius: {{ block.settings.top_radius }}px {{ block.settings.top_radius }}px 8px 8px; transition: transform 0.3s ease; }
  .ai-dome-card-{{ ai_gen_id }}:hover { transform: translateY(-4px); }
  .ai-dome-card-{{ ai_gen_id }}__media { position: relative; width: 100%; aspect-ratio: 4 / 5; overflow: hidden; background: #f2f2f2; }
  .ai-dome-card-{{ ai_gen_id }}__media img, .ai-dome-card-{{ ai_gen_id }}__media svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-dome-card-{{ ai_gen_id }}__media svg { padding: 18%; color: #777777; }
  .ai-dome-card-{{ ai_gen_id }}__content { padding: 16px 14px 18px; text-align: {{ block.settings.card_alignment }}; }
  .ai-dome-card-{{ ai_gen_id }}__title { margin: 0 0 6px; font-family: 'Outfit', sans-serif; font-size: {{ block.settings.card_title_size }}px; line-height: 1.25; color: #000000 !important; font-weight: 600; text-decoration: none; }
  .ai-dome-card-{{ ai_gen_id }}__title a { color: #000000 !important; text-decoration: none; }
  .ai-dome-card-{{ ai_gen_id }}__text { margin: 0; font-size: 14px; line-height: 1.45; color: #44403c; }
  .ai-dome-card-{{ ai_gen_id }}__link { display: inline-block; margin-top: 12px; color: #000000; font-size: 14px; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .ai-dome-cards-{{ ai_gen_id }}__inner { width: 100%; }
    .ai-dome-cards-{{ ai_gen_id }}__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .ai-dome-cards-{{ ai_gen_id }}__heading { font-size: {{ block.settings.heading_size | times: 0.75 }}px; }
    .ai-dome-card-{{ ai_gen_id }}__content { padding: 14px 12px 16px; }
  }
</style>

<div class="ai-dome-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dome-cards-{{ ai_gen_id }}__inner">
    <div class="ai-dome-cards-{{ ai_gen_id }}__header">
      {% if block.settings.subheading != blank %}
        <div class="ai-dome-cards-{{ ai_gen_id }}__subheading">{{ block.settings.subheading | escape }}</div>
      {% endif %}
      
      {% if block.settings.heading != blank %}
        <h2 class="ai-dome-cards-{{ ai_gen_id }}__heading">
          {% assign heading_words = block.settings.heading | split: ' ' %}
          {% if heading_words.size >= 3 %}
            {{ heading_words[0] }} {{ heading_words[1] }} <span class="gold-text">{% for i in (2..heading_words.size) %}{{ heading_words[i] }} {% endfor %}</span>
          {% else %}
            <span class="gold-text">{{ block.settings.heading | escape }}</span>
          {% endif %}
        </h2>
      {% endif %}
    </div>

    <div class="ai-dome-cards-{{ ai_gen_id }}__grid">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'card_' | append: i | append: '_image'
          assign title_key = 'card_' | append: i | append: '_title'
          assign text_key = 'card_' | append: i | append: '_text'
          assign link_key = 'card_' | append: i | append: '_link'
          assign image = block.settings[image_key]
          assign title = block.settings[title_key]
          assign text = block.settings[text_key]
          assign link = block.settings[link_key]
        %}
        <article class="ai-dome-card-{{ ai_gen_id }}">
          {% if link != blank %}
            <a href="{{ link }}" style="text-decoration:none; color:inherit; display:block;">
          {% endif %}
          <div class="ai-dome-card-{{ ai_gen_id }}__media">
            {% if image != blank -%}
              <img
                src="{{ image | image_url: width: 1200 }}"
                alt="{{ image.alt | default: title | escape }}"
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="lazy"
              >
            {%- else -%}
              {{- 'image' | placeholder_svg_tag -}}
            {%- endif %}
          </div>
          <div class="ai-dome-card-{{ ai_gen_id }}__content">
            {% if title != blank %}
              <h3 class="ai-dome-card-{{ ai_gen_id }}__title">{{ title | escape }}</h3>
            {% endif %}
            {% if text != blank %}
              <p class="ai-dome-card-{{ ai_gen_id }}__text">{{ text | escape }}</p>
            {% endif %}
            {% if link != blank and block.settings.link_label != blank -%}
              <span class="ai-dome-card-{{ ai_gen_id }}__link">
                {{- block.settings.link_label | escape -}}
              </span>
            {%- endif %}
          </div>
          {% if link != blank %}
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Dome card grid",
  "tag": null,
  "class": "dome-card-grid-block",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading / Eyebrow", "default": "Find Your Perfect Pick" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore our collection" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "" },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title size",
      "min": 14,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "top_radius",
      "label": "Top radius",
      "min": 30,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section spacing",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#FBF5EA" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "header", "content": "Card 1" },
    { "type": "image_picker", "id": "card_1_image", "label": "Image" },
    { "type": "text", "id": "card_1_title", "label": "Title", "default": "Lemon tea" },
    { "type": "textarea", "id": "card_1_text", "label": "Description", "default": "" },
    { "type": "url", "id": "card_1_link", "label": "Link" },
    { "type": "header", "content": "Card 2" },
    { "type": "image_picker", "id": "card_2_image", "label": "Image" },
    { "type": "text", "id": "card_2_title", "label": "Title", "default": "Herbal Tea" },
    { "type": "textarea", "id": "card_2_text", "label": "Description", "default": "" },
    { "type": "url", "id": "card_2_link", "label": "Link" },
    { "type": "header", "content": "Card 3" },
    { "type": "image_picker", "id": "card_3_image", "label": "Image" },
    { "type": "text", "id": "card_3_title", "label": "Title", "default": "Green Tea" },
    { "type": "textarea", "id": "card_3_text", "label": "Description", "default": "" },
    { "type": "url", "id": "card_3_link", "label": "Link" },
    { "type": "header", "content": "Card 4" },
    { "type": "image_picker", "id": "card_4_image", "label": "Image" },
    { "type": "text", "id": "card_4_title", "label": "Title", "default": "Premium Coffee" },
    { "type": "textarea", "id": "card_4_text", "label": "Description", "default": "" },
    { "type": "url", "id": "card_4_link", "label": "Link" }
  ],
  "presets": [{ "name": "Dome card grid" }]
}
{% endschema %}
