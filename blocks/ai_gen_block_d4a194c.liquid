{% doc %}
  @prompt
    Explore our collection section with uppercase black subheading, golden Myanmar MN heading, and clickable card image & title
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

<style>
  .ai-dome-cards-{{ ai_gen_id }} {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    padding: {{ block.settings.section_padding | default: 48 }}px 0 !important;
    color: #000000 !important;
    background-color: {{ block.settings.section_background | default: "#fbf5ea" }} !important;
  }

  .ai-dome-cards-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent | default: 90 }}% !important;
    max-width: 100% !important;
    margin: 0 auto !important;
  }

  .ai-dome-cards-{{ ai_gen_id }}__header {
    margin-bottom: 28px !important;
    text-align: center !important;
  }

  /* Subheading */
  .ai-dome-cards-{{ ai_gen_id }}__subheading,
  .ai-dome-subheading {
    display: block !important;
    font-family: 'Outfit', sans-serif !important;
    font-size: 0.95rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.08em !important;
    color: #000000 !important;
    margin-bottom: 8px !important;
    text-transform: uppercase !important;
    text-align: center !important;
  }

  /* Main Heading */
  .ai-dome-cards-{{ ai_gen_id }}__heading,
  .ai-dome-heading {
    margin: 0 !important;
    font-family: 'Myanmar MN', 'Myanmar Sangam MN', 'Cormorant Garamond', serif !important;
    font-size: {{ block.settings.heading_size | default: 40 }}px !important;
    line-height: 1.2 !important;
    font-weight: 700 !important;
    color: #b88146 !important;
    text-align: center !important;
  }

  /* Card Grid */
  .ai-dome-cards-{{ ai_gen_id }}__grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: {{ block.settings.card_gap | default: 24 }}px !important;
  }

  /* Card */
  .ai-dome-card-{{ ai_gen_id }} {
    min-width: 0 !important;
    overflow: hidden !important;
    background: {{ block.settings.card_background | default: "rgba(0,0,0,0)" }} !important;
    border-radius: {{ block.settings.top_radius | default: 120 }}px {{ block.settings.top_radius | default: 120 }}px 12px 12px !important;
    transition: transform 0.3s ease, box-shadow 0.3s ease !important;
  }

  .ai-dome-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px) !important;
    box-shadow: 0 10px 20px rgba(0,0,0,0.06) !important;
  }

  /* Entire image + title is clickable */
  .ai-dome-card-{{ ai_gen_id }}__card-link {
    display: block !important;
    text-decoration: none !important;
    color: #000000 !important;
    cursor: pointer !important;
    width: 100% !important;
    height: 100% !important;
  }

  /* Image */
  .ai-dome-card-{{ ai_gen_id }}__media {
    position: relative !important;
    width: 100% !important;
    aspect-ratio: 4 / 5 !important;
    overflow: hidden !important;
    background: #f2ece1 !important;
  }

  .ai-dome-card-{{ ai_gen_id }}__media img,
  .ai-dome-card-{{ ai_gen_id }}__media svg {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    transition: transform 0.4s ease !important;
  }

  .ai-dome-card-{{ ai_gen_id }}:hover .ai-dome-card-{{ ai_gen_id }}__media img {
    transform: scale(1.05) !important;
  }

  /* Collection Name */
  .ai-dome-card-{{ ai_gen_id }}__content {
    padding: 16px 14px 18px !important;
    text-align: center !important;
  }

  .ai-dome-card-{{ ai_gen_id }}__title,
  .ai-dome-card-title {
    margin: 0 !important;
    font-family: 'Outfit', sans-serif !important;
    font-size: {{ block.settings.card_title_size | default: 20 }}px !important;
    line-height: 1.25 !important;
    color: #000000 !important;
    font-weight: 600 !important;
    text-decoration: none !important;
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .ai-dome-cards-{{ ai_gen_id }}__inner {
      width: 100% !important;
    }

    .ai-dome-cards-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 14px !important;
    }

    .ai-dome-cards-{{ ai_gen_id }}__heading {
      font-size: 1.85rem !important;
    }

    .ai-dome-card-{{ ai_gen_id }}__content {
      padding: 14px 12px 16px !important;
    }
  }
</style>

<div class="ai-dome-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dome-cards-{{ ai_gen_id }}__inner">

    <!-- Section Header -->
    <div class="ai-dome-cards-{{ ai_gen_id }}__header">

      {% assign subheading_text = block.settings.subheading %}
      {% if subheading_text == blank %}
        {% assign subheading_text = "FIND YOUR PERFECT PICK" %}
      {% endif %}
      <div class="ai-dome-cards-{{ ai_gen_id }}__subheading ai-dome-subheading">
        {{ subheading_text | upcase | escape }}
      </div>

      {% if block.settings.heading != blank %}
        <h2 class="ai-dome-cards-{{ ai_gen_id }}__heading ai-dome-heading">
          {{ block.settings.heading | escape }}
        </h2>
      {% endif %}

    </div>

    <!-- Collection Cards -->
    <div class="ai-dome-cards-{{ ai_gen_id }}__grid">

      {% for i in (1..4) %}

        {% liquid
          assign image_key = 'card_' | append: i | append: '_image'
          assign title_key = 'card_' | append: i | append: '_title'
          assign text_key = 'card_' | append: i | append: '_text'
          assign link_key = 'card_' | append: i | append: '_link'

          assign image = block.settings[image_key]
          assign title = block.settings[title_key]
          assign text = block.settings[text_key]
          assign link = block.settings[link_key]

          assign card_url = link
          if card_url == blank
            assign card_url = '/collections/all'
          endif
        %}

        <article class="ai-dome-card-{{ ai_gen_id }}">

          <!-- Image AND Collection Name share the same link -->
          <a
            href="{{ card_url }}"
            class="ai-dome-card-{{ ai_gen_id }}__card-link"
            aria-label="Shop {{ title | escape }}"
          >

            <!-- Collection Image -->
            <div class="ai-dome-card-{{ ai_gen_id }}__media">

              {% if image != blank %}

                <img
                  src="{{ image | image_url: width: 1200 }}"
                  alt="{{ image.alt | default: title | escape }}"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  loading="lazy"
                >

              {% else %}

                {{ 'image' | placeholder_svg_tag }}

              {% endif %}

            </div>

            <!-- Collection Name -->
            <div class="ai-dome-card-{{ ai_gen_id }}__content">

              {% if title != blank %}
                <h3 class="ai-dome-card-{{ ai_gen_id }}__title ai-dome-card-title">
                  {{ title | escape }}
                </h3>
              {% endif %}

            </div>

          </a>

        </article>

      {% endfor %}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Dome card grid",
  "tag": null,
  "class": "dome-card-grid-block",
  "settings": [

