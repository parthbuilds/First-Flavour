{% doc %}
  @prompt
    Create a Shopify section with a 2-column layout (1/4 width on the left, 3/4 width on the right). On the left, display a tall media container shaped like a dome (fully rounded top corners and slightly rounded bottom corners) that supports either an image or an embedded video. On the right, include a heading, a list of feature items with icons/text, and trust badges at the bottom. Make sure it is fully mobile-responsive (stacking vertically on mobile).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-dome-feature-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }
  .ai-dome-feature-{{ ai_gen_id }}__layout {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: auto;
    display: grid;
    grid-template-columns: 0.5fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }
  .ai-dome-feature-{{ ai_gen_id }}__media {
    width: 100%;
    height: 100%;
    max-height: {{ block.settings.media_height }}px;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: {{ block.settings.media_background }};
    border-radius: 999px 999px {{ block.settings.bottom_radius }}px {{ block.settings.bottom_radius }}px;
  }
  .ai-dome-feature-{{ ai_gen_id }}__media img,
  .ai-dome-feature-{{ ai_gen_id }}__media video,
  .ai-dome-feature-{{ ai_gen_id }}__media iframe {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover; /* Fills the dome completely without shrinking */
    object-position: center;
    border: 0;
  }
  .ai-dome-feature-{{ ai_gen_id }}__placeholder {
    height: 100%;
    min-height: {{ block.settings.media_height }}px;
    display: grid;
    place-items: center;
    position: relative;
    color: {{ block.settings.muted_color }};
  }
  .ai-dome-feature-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
  }
  .ai-dome-feature-{{ ai_gen_id }}__empty {
    position: absolute;
    bottom: 20px;
    left: 16px;
    right: 16px;
    text-align: center;
    font-size: 13px;
  }
  .ai-dome-feature-{{ ai_gen_id }}__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: {{ block.settings.content_padding }}px 0;
    color: {{ block.settings.text_color }};
  }
  .ai-dome-feature-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 12px;
    color: {{ block.settings.accent_color }};
    font-size: 13px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .ai-dome-feature-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    font-family: {{ settings.type_heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
  }
  .ai-dome-feature-{{ ai_gen_id }}__features {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ai-dome-feature-{{ ai_gen_id }}__feature {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .ai-dome-feature-{{ ai_gen_id }}__icon {
    flex: 0 0 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: {{ block.settings.icon_background }};
    color: {{ block.settings.icon_color }};
    font-size: 18px;
    font-weight: 700;
  }
  .ai-dome-feature-{{ ai_gen_id }}__feature-text {
    padding-top: 8px;
    font-size: 16px;
    line-height: 1.45;
  }
  .ai-dome-feature-{{ ai_gen_id }}__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid {{ block.settings.divider_color }};
  }
  .ai-dome-feature-{{ ai_gen_id }}__badge {
    padding: 9px 13px;
    border: 1px solid {{ block.settings.divider_color }};
    border-radius: 999px;
    color: {{ block.settings.text_color }};
    font-size: 13px;
  }
  @media(max-width: 749px) {
    .ai-dome-feature-{{ ai_gen_id }}__layout {
      width: 100%;
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .ai-dome-feature-{{ ai_gen_id }}__media {
      aspect-ratio: 4 / 5;
      min-height: {{ block.settings.mobile_media_height }}px;
    }
    .ai-dome-feature-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }
    .ai-dome-feature-{{ ai_gen_id }}__content {
      padding: 0;
    }
  }
{% endstyle %}
<div class="ai-dome-feature-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dome-feature-{{ ai_gen_id }}__layout">
    <div class="ai-dome-feature-{{ ai_gen_id }}__media">
      {% if block.settings.media_type == 'video' and block.settings.shopify_video != blank -%}
        {{ block.settings.shopify_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, preload: 'auto' }}
      {%- elsif block.settings.image -%}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {%- else %}
        <div class="ai-dome-feature-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag -}}
          <span class="ai-dome-feature-{{ ai_gen_id }}__empty">Add an image or video URL</span>
        </div>
      {% endif %}
    </div>
    <div class="ai-dome-feature-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-dome-feature-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="ai-dome-feature-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>
      <ul class="ai-dome-feature-{{ ai_gen_id }}__features">
        {% for i in (1..3) -%}
          {%- assign text_key = 'feature_' | append: i -%}
          {%- assign icon_key = 'icon_' | append: i -%}
          {%- if block.settings[text_key] != blank %}
            <li class="ai-dome-feature-{{ ai_gen_id }}__feature">
              <span class="ai-dome-feature-{{ ai_gen_id }}__icon" aria-hidden="true">
                {{- block.settings[icon_key] -}}</span
              ><span class="ai-dome-feature-{{ ai_gen_id }}__feature-text">{{ block.settings[text_key] }}</span>
            </li>
          {% endif -%}
        {%- endfor %}
      </ul>
      <div class="ai-dome-feature-{{ ai_gen_id }}__badges" aria-label="Trust badges">
        {% for i in (1..3) -%}
          {%- assign badge_key = 'badge_' | append: i -%}
          {%- if block.settings[badge_key] != blank -%}
            <span class="ai-dome-feature-{{ ai_gen_id }}__badge">{{ block.settings[badge_key] }}</span>
          {%- endif -%}
        {%- endfor %}
      </div>
    </div>
  </div>
</div>
{% schema %}{"name":"Dome feature layout","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Why choose us"},{"type":"text","id":"heading","label":"Heading","default":"Thoughtfully made for every pour"},{"type":"text","id":"feature_1","label":"Feature one","default":"Premium ingredients, carefully selected"},{"type":"text","id":"icon_1","label":"Icon one","default":"✓"},{"type":"text","id":"feature_2","label":"Feature two","default":"Crafted in small batches for freshness"},{"type":"text","id":"icon_2","label":"Icon two","default":"✦"},{"type":"text","id":"feature_3","label":"Feature three","default":"Delivered fresh to your door"},{"type":"text","id":"icon_3","label":"Icon three","default":"♡"},{"type":"select","id":"media_type","label":"Media type","options":[{"value":"image","label":"Image"},{"value":"video","label":"Video"}],"default":"image"},{"type":"image_picker","id":"image","label":"Image"},{"type":"video","id":"shopify_video","label":"Shopify library video"},{"type":"text","id":"badge_1","label":"Badge one","default":"Small-batch crafted"},{"type":"text","id":"badge_2","label":"Badge two","default":"Secure checkout"},{"type":"text","id":"badge_3","label":"Badge three","default":"Fast delivery"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"column_gap","label":"Column gap","min":16,"max":80,"step":4,"unit":"px","default":40},{"type":"range","id":"media_height","label":"Media height","min":320,"max":900,"step":20,"unit":"px","default":620},{"type":"range","id":"mobile_media_height","label":"Mobile media height","min":240,"max":600,"step":20,"unit":"px","default":420},{"type":"range","id":"content_padding","label":"Content padding","min":0,"max":80,"step":5,"unit":"px","default":25},{"type":"range","id":"heading_size","label":"Heading size","min":24,"max":72,"step":4,"unit":"px","default":48},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":22,"max":48,"step":2,"unit":"px","default":32},{"type":"range","id":"top_radius","label":"Top radius","min":20,"max":100,"step":5,"unit":"px","default":100},{"type":"range","id":"bottom_radius","label":"Bottom radius","min":0,"max":40,"step":5,"unit":"px","default":15},{"type":"color","id":"media_background","label":"Media background","default":"#F2F0EB"},{"type":"color","id":"text_color","label":"Text","default":"#000000"},{"type":"color","id":"accent_color","label":"Accent","default":"#333333"},{"type":"color","id":"icon_background","label":"Icon background","default":"#000000"},{"type":"color","id":"icon_color","label":"Icon","default":"#FFFFFF"},{"type":"color","id":"divider_color","label":"Divider","default":"#DFDFDF"}],"presets":[{"name":"Dome feature layout"}],"tag":null,"class":"dome-feature-block"}{% endschema %}
