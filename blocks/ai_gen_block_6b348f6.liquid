{% doc %}
  @prompt
    generate a customer review section it should have like 5-6 cards , the cards should be vertical cards at a time it should show 3 cards and there should be a left and right button as well palced in the left right above the images in the left right sides the cards should have a image and a heading and description with a star rating thing please , make sure the stars can be edited but setting a score out of 5 and like if i give like a 4 then 4 starts out of 5 should be yellow 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; padding:48px 0; color:{{ block.settings.text_color }}; background:{{ block.settings.background_color }}; }
  .ai-reviews-{{ ai_gen_id }}__inner { max-width:1200px; margin:0 auto; padding:0 24px; }
  .ai-reviews-{{ ai_gen_id }}__header { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:28px; }
  .ai-reviews-{{ ai_gen_id }}__title { margin:0; font-size:32px; line-height:1.1; font-weight:700; }
  .ai-reviews-{{ ai_gen_id }}__subtitle { margin:10px 0 0; font-size:16px; line-height:1.5; }
  .ai-reviews-{{ ai_gen_id }}__controls { display:flex; gap:8px; flex-shrink:0; }
  .ai-reviews-{{ ai_gen_id }}__button { width:42px; height:42px; border:1px solid {{ block.settings.button_border_color }}; border-radius:50%; background:{{ block.settings.button_background }}; color:{{ block.settings.button_text_color }}; display:grid; place-items:center; cursor:pointer; }
  .ai-reviews-{{ ai_gen_id }}__button:disabled { opacity:.4; cursor:not-allowed; }
  .ai-reviews-{{ ai_gen_id }}__button:focus-visible { outline:3px solid #8a6500; outline-offset:3px; }
  .ai-reviews-{{ ai_gen_id }}__viewport { overflow:hidden; }
  .ai-reviews-{{ ai_gen_id }}__track { display:flex; gap:18px; transition:transform .25s ease; }
  .ai-reviews-{{ ai_gen_id }}__card { flex:0 0 calc((100% - 36px) / 3); overflow:hidden; border:1px solid {{ block.settings.card_border_color }}; border-radius:{{ block.settings.card_radius }}px; background:{{ block.settings.card_background }}; }
  .ai-reviews-{{ ai_gen_id }}__image, .ai-reviews-{{ ai_gen_id }}__placeholder { aspect-ratio:4/3; width:100%; display:block; object-fit:cover; background:#eeeeee; }
  .ai-reviews-{{ ai_gen_id }}__placeholder { color:#777; }
  .ai-reviews-{{ ai_gen_id }}__placeholder svg { width:100%; height:100%; }
  .ai-reviews-{{ ai_gen_id }}__content { padding:22px; }
  .ai-reviews-{{ ai_gen_id }}__stars { color:{{ block.settings.star_color }}; letter-spacing:2px; font-size:19px; line-height:1; }
  .ai-reviews-{{ ai_gen_id }}__heading { margin:14px 0 8px; font-size:20px; line-height:1.25; }
  .ai-reviews-{{ ai_gen_id }}__description { margin:0; font-size:15px; line-height:1.6; }
  @media(max-width:749px) { .ai-reviews-{{ ai_gen_id }} { padding:36px 0; } .ai-reviews-{{ ai_gen_id }}__header { align-items:flex-start; flex-direction:column; } .ai-reviews-{{ ai_gen_id }}__card { flex-basis:100%; } .ai-reviews-{{ ai_gen_id }}__title { font-size:28px; } }
{% endstyle %}

<customer-reviews-{{ ai_gen_id }} class="ai-reviews-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-{{ ai_gen_id }}__inner">
    <div class="ai-reviews-{{ ai_gen_id }}__header">
      <div><h2 class="ai-reviews-{{ ai_gen_id }}__title">{{ block.settings.title }}</h2><p class="ai-reviews-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle }}</p></div>
      <div class="ai-reviews-{{ ai_gen_id }}__controls">
        <button class="ai-reviews-{{ ai_gen_id }}__button" type="button" data-direction="prev" aria-label="Previous reviews">←</button>
        <button class="ai-reviews-{{ ai_gen_id }}__button" type="button" data-direction="next" aria-label="Next reviews">→</button>
      </div>
    </div>
    <div class="ai-reviews-{{ ai_gen_id }}__viewport"><div class="ai-reviews-{{ ai_gen_id }}__track">
      {% for i in (1..6) %}
        {% liquid
          assign image_key = 'review_' | append: i | append: '_image'
          assign heading_key = 'review_' | append: i | append: '_heading'
          assign description_key = 'review_' | append: i | append: '_description'
          assign rating_key = 'review_' | append: i | append: '_rating'
          assign image = block.settings[image_key]
          assign heading = block.settings[heading_key]
          assign description = block.settings[description_key]
          assign rating = block.settings[rating_key]
        %}
        <article class="ai-reviews-{{ ai_gen_id }}__card">
          {% if image %}<img class="ai-reviews-{{ ai_gen_id }}__image" src="{{ image | image_url: width: 800 }}" alt="{{ image.alt | escape }}" loading="lazy" width="800" height="600">{% else %}<div class="ai-reviews-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
          <div class="ai-reviews-{{ ai_gen_id }}__content"><div class="ai-reviews-{{ ai_gen_id }}__stars" aria-label="{{ rating }} out of 5 stars">{% for star in (1..5) %}{% if star <= rating %}★{% else %}☆{% endif %}{% endfor %}</div><h3 class="ai-reviews-{{ ai_gen_id }}__heading">{{ heading }}</h3><p class="ai-reviews-{{ ai_gen_id }}__description">{{ description }}</p></div>
        </article>
      {% endfor %}
    </div></div>
  </div>
</customer-reviews-{{ ai_gen_id }}>

<script>
(function(){
  class CustomerReviews{{ ai_gen_id }} extends HTMLElement {
    connectedCallback(){ this.track=this.querySelector('.ai-reviews-{{ ai_gen_id }}__track'); this.buttons=this.querySelectorAll('[data-direction]'); this.index=0; this.update(); this.buttons.forEach(b=>b.addEventListener('click',()=>{ this.index += b.dataset.direction==='next' ? 1 : -1; this.update(); })); window.addEventListener('resize',()=>this.update()); }
    update(){ const mobile=window.innerWidth<750; const visible=mobile?1:3; const max=Math.max(0,6-visible); this.index=Math.max(0,Math.min(this.index,max)); const card=this.track.children[0]; if(!card)return; const distance=card.getBoundingClientRect().width+18; this.track.style.transform='translateX(-'+(this.index*distance)+'px)'; this.buttons[0].disabled=this.index===0; this.buttons[1].disabled=this.index===max; }
  }
  customElements.define('customer-reviews-{{ ai_gen_id }}',CustomerReviews{{ ai_gen_id }});
})();
</script>

