{% comment %}
  Explore Our Collection - Custom Standalone Section with Dome Cards
{% endcomment %}

<style>
  .eoc-section {
    padding: {{ section.settings.padding_top | default: 48 }}px 20px {{ section.settings.padding_bottom | default: 48 }}px;
    background-color: {{ section.settings.bg_color | default: "#fbf5ea" }};
    font-family: 'Outfit', sans-serif;
  }

  .eoc-container {
    max-width: 1280px;
    margin: 0 auto;
    width: {{ section.settings.desktop_width | default: 90 }}%;
  }

  .eoc-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .eoc-eyebrow {
    font-family: 'Outfit', sans-serif !important;
    font-size: 0.95rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.08em !important;
    color: #000000 !important;
    margin-bottom: 6px !important;
    text-transform: uppercase !important;
    text-align: center !important;
  }

  .eoc-heading {
    font-family: 'Myanmar MN', 'Myanmar Sangam MN', 'Cormorant Garamond', serif !important;
    font-size: {{ section.settings.heading_size | default: 40 }}px !important;
    font-weight: 700 !important;
    color: #b88146 !important;
    margin: 0 !important;
    line-height: 1.2 !important;
    text-align: center !important;
  }

  .eoc-grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: {{ section.settings.card_gap | default: 24 }}px !important;
  }

  .eoc-card {
    background: {{ section.settings.card_bg | default: "rgba(0,0,0,0)" }} !important;
    border-radius: {{ section.settings.top_radius | default: 120 }}px {{ section.settings.top_radius | default: 120 }}px 12px 12px !important;
    overflow: hidden !important;
    transition: transform 0.3s ease, box-shadow 0.3s ease !important;
  }

  .eoc-card:hover {
    transform: translateY(-5px) !important;
    box-shadow: 0 10px 24px rgba(0,0,0,0.06) !important;
  }

  .eoc-card-link {
    display: block !important;
    text-decoration: none !important;
    color: #000000 !important;
    cursor: pointer !important;
    width: 100% !important;
    height: 100% !important;
  }

  .eoc-media {
    position: relative !important;
    width: 100% !important;
    aspect-ratio: 4 / 5 !important;
    overflow: hidden !important;
    background-color: #f2ece1 !important;
  }

  .eoc-media img, .eoc-media svg {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    transition: transform 0.4s ease !important;
  }

  .eoc-card:hover .eoc-media img {
    transform: scale(1.06) !important;
  }

  .eoc-content {
    padding: 16px 12px 18px !important;
    text-align: center !important;
  }

  .eoc-title {
    margin: 0 !important;
    font-family: 'Outfit', sans-serif !important;
    font-size: {{ section.settings.title_size | default: 20 }}px !important;
    font-weight: 600 !important;
    color: #000000 !important;
    line-height: 1.25 !important;
    text-decoration: none !important;
  }

  .eoc-desc {
    margin: 4px 0 0 !important;
    font-size: 0.88rem !important;
    color: #57534e !important;
    line-height: 1.4 !important;
  }

  @media screen and (max-width: 768px) {
    .eoc-container {
      width: 100% !important;
    }
    .eoc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 14px !important;
    }
    .eoc-heading {
      font-size: 1.85rem !important;
    }
    .eoc-content {
      padding: 12px 10px 14px !important;
    }
  }
</style>

<section class="eoc-section" id="explore-collection-{{ section.id }}">
  <div class="eoc-container">
    
    <!-- Section Header -->
    <div class="eoc-header">
      <div class="eoc-eyebrow">
        FIND YOUR PERFECT PICK
      </div>
      
      <h2 class="eoc-heading">
        {{ section.settings.heading | default: "Explore our collection" }}
      </h2>
    </div>

    <!-- Dome Cards Grid -->
    <div class="eoc-grid">
      {% for block in section.blocks %}
        {% assign card_img = block.settings.image %}
        {% assign card_url = block.settings.link | default: '/collections/all' %}
        
        <article class="eoc-card" {{ block.shopify_attributes }}>
          <a href="{{ card_url }}" class="eoc-card-link">
            <div class="eoc-media">
              {% if card_img != blank %}
                <img 
                  src="{{ card_img | image_url: width: 1000 }}" 
                  alt="{{ card_img.alt | default: block.settings.title | escape }}"
                  loading="lazy"
                  width="1000"
                  height="1250"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>

            <div class="eoc-content">
              {% if block.settings.title != blank %}
                <h3 class="eoc-title">{{ block.settings.title }}</h3>
              {% endif %}
              
              {% if block.settings.subtitle != blank %}
                <p class="eoc-desc">{{ block.settings.subtitle }}</p>
              {% endif %}
            </div>
          </a>
        </article>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Explore Our Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Subheading",
      "default": "Find Your Perfect Pick"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore our collection"
    },
    {
      "type": "range",
      "id": "desktop_width",
      "label": "Desktop Width",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Card Title Size",
      "min": 14,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "top_radius",
      "label": "Dome Top Radius",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card Gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#fbf5ea"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "dome_card",
      "name": "Dome Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Collection Name",
          "default": "Lemon tea"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Description (Optional)",
          "default": ""
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link Target"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Explore Our Collection",
      "blocks": [
        { "type": "dome_card", "settings": { "title": "Lemon tea", "link": "/collections/all" } },
        { "type": "dome_card", "settings": { "title": "Herbal Tea", "link": "/collections/all" } },
        { "type": "dome_card", "settings": { "title": "Green Tea", "link": "/collections/all" } },
        { "type": "dome_card", "settings": { "title": "Premium Coffee", "link": "/collections/all" } }
      ]
    }
  ]
}
{% endschema %}
