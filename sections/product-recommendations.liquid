{% comment %}
  Product Recommendations Section - Guaranteed Fallback to Catalog Products
{% endcomment %}

{% liquid
  case section.settings.layout_type
    when 'grid'
      assign classes = 'resource-list--grid'
    when 'carousel'
      assign classes = 'resource-list__carousel'
  endcase

  capture styles
    echo '--column-count-mobile: ' | append: section.settings.mobile_columns | append: ';'
    echo '--resource-list-column-gap-desktop: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--resource-list-row-gap-desktop: ' | append: section.settings.rows_gap | append: 'px;'
    echo '--resource-list-columns: repeat(' | append: section.settings.columns | append: ', 1fr);'
    echo '--resource-list-columns-mobile: repeat(' | append: section.settings.mobile_columns | append: ', 1fr);'
    echo '--column-count: ' | append: section.settings.columns | append: ';'
    echo '--column-count-mobile: ' | append: section.settings.mobile_columns | append: ';'
  endcapture
%}

{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'swatch-styles' %}
{% render 'quantity-selector-styles' %}
{% render 'variant-picker-styles' %}
{% render 'product-badges-styles' %}
{% render 'resource-list-styles' %}
{% render 'product-recommendations-styles' %}

<style>
  .product-rec-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 40px 20px 60px;
    font-family: 'Outfit', sans-serif;
  }
  .product-rec-header {
    text-align: left;
    margin-bottom: 24px;
  }
  .product-rec-header h2, .product-rec-header h3 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2.2rem;
    font-weight: 700;
    color: #1c1917;
    margin: 0;
  }
  .product-rec-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr);
    gap: 24px;
  }
  @media (max-width: 900px) {
    .product-rec-grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns | default: 2 }}, 1fr);
      gap: 14px;
    }
  }
</style>

<div class="product-rec-container" id="product-recommendations-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="product-rec-header">
    {% content_for 'blocks' %}
  </div>

  {% liquid
    assign rec_products = recommendations.products
    assign max_limit = section.settings.max_products | default: 4

    if rec_products == blank or rec_products.size == 0
      assign current_id = product.id
      assign rec_products = collections.all.products | reject: 'id', current_id
    endif

    if rec_products == blank or rec_products.size == 0
      assign rec_products = collections['all'].products
    endif
  %}

  <div class="product-rec-grid">
    {% for rec_prod in rec_products limit: max_limit %}
      <div class="product-rec-item">
        {% render 'sbp-product-card', product: rec_prod %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Product Recommendations",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "Recommendation Type",
      "options": [
        { "value": "related", "label": "Related Products" },
        { "value": "complementary", "label": "Complementary Products" }
      ],
      "default": "related"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout Style",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max Products to Show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop Columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    }
  ],
  "presets": [
    {
      "name": "Product Recommendations",
      "category": "Products",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "<h3>You may also like</h3>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
