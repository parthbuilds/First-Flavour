{{ 'component-custom-bento.css' | asset_url | stylesheet_tag }}

<section class="custom-bento-section section-{{ section.id }}-padding">
  <div class="custom-bento-container">
    
    {%- if section.settings.heading != blank -%}
      <div class="custom-bento-header">
        <h2 class="custom-bento-title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="custom-bento-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="custom-bento-card bento-card-{{ forloop.index }}" {{ block.shopify_attributes }}>
          
          <div class="custom-bento-image-wrapper">
            {%- if block.settings.image != blank -%}
              <img 
                srcset="{{ block.settings.image | image_url: width: 600 }} 600w,
                        {{ block.settings.image | image_url: width: 900 }} 900w,
                        {{ block.settings.image | image_url: width: 1200 }} 1200w"
                sizes="(min-width: 1024px) 600px, 100vw"
                src="{{ block.settings.image | image_url: width: 1200 }}" 
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="1200"
                height="900"
                class="custom-bento-img">
            {%- else -%}
              <div class="custom-bento-placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
            <div class="custom-bento-overlay"></div>
          </div>

          <div class="custom-bento-content content-pos-{{ block.settings.text_position }}">
            {%- if block.settings.title != blank -%}
              <span class="custom-bento-card-title">{{ block.settings.title }}</span>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <span class="custom-bento-card-subtitle">{{ block.settings.subtitle }}</span>
            {%- endif -%}
          </div>

        </a>
      {%- endfor -%}
    </div>

  </div>
</section>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Custom Bento Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Featured Collections"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "bento_item",
      "name": "Bento Card",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Collection Title",
          "default": "First Flavour Tea"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / CTA text",
          "default": "Explore Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link Target"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text Position",
          "options": [
            {"value": "bottom-left", "label": "Bottom Left"},
            {"value": "bottom-right", "label": "Bottom Right"},
            {"value": "top-left", "label": "Top Left"},
            {"value": "center", "label": "Center"}
          ],
          "default": "bottom-left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Bento Grid",
      "blocks": [
        {"type": "bento_item", "settings": {"title": "First Flavour Tea"}},
        {"type": "bento_item", "settings": {"title": "Coffee Blend"}},
        {"type": "bento_item", "settings": {"title": "Lemon Tea"}},
        {"type": "bento_item", "settings": {"title": "Special Gifting"}}
      ]
    }
  ]
}
{% endschema %}