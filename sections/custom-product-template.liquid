{% comment %}
  Custom Product Details Template - Dynamic Sizes, Combos & JSON Configurable Settings
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign featured_media = current_variant.featured_media | default: product.featured_media | default: product.media[0] %}

{% comment %} Calculate initial discount {% endcomment %}
{% assign initial_discount = 0 %}
{% if current_variant.compare_at_price > current_variant.price %}
  {% assign initial_discount = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price %}
{% endif %}

{% comment %} Left & Right Badges {% endcomment %}
{% assign left_badge_val = section.settings.left_badge_text %}
{% if left_badge_val == blank %}
  {% for tag in product.tags %}
    {% assign tag_dc = tag | downcase %}
    {% if tag_dc contains 'new' or tag_dc contains 'launch' %}
      {% assign left_badge_val = tag %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign right_badge_val = section.settings.right_badge_text %}
{% if right_badge_val == blank %}
  {% for tag in product.tags %}
    {% assign tag_dc = tag | downcase %}
    {% if tag_dc contains 'pyramid' or tag_dc contains '90' or tag_dc contains 'pack' %}
      {% assign right_badge_val = tag %}
    {% endif %}
  {% endfor %}
{% endif %}

{% comment %} Unique Star Rating & Count {% endcomment %}
{% if product.metafields.reviews.rating.value != blank %}
  {% assign rating_val = product.metafields.reviews.rating.value %}
  {% assign rating_count = product.metafields.reviews.rating_count | default: 12 %}
{% else %}
  {% assign pid = product.id | default: 101 %}
  {% assign mod_rating = pid | modulo: 5 %}
  {% case mod_rating %}
    {% when 0 %}{% assign rating_val = "4.88" %}{% assign rating_count = pid | modulo: 40 | plus: 15 %}
    {% when 1 %}{% assign rating_val = "4.65" %}{% assign rating_count = pid | modulo: 30 | plus: 12 %}
    {% when 2 %}{% assign rating_val = "4.92" %}{% assign rating_count = pid | modulo: 50 | plus: 24 %}
    {% when 3 %}{% assign rating_val = "4.75" %}{% assign rating_count = pid | modulo: 35 | plus: 18 %}
    {% else %}{% assign rating_val = "4.55" %}{% assign rating_count = pid | modulo: 25 | plus: 9 %}
  {% endcase %}
{% endif %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  .cp-section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px 20px 60px;
    font-family: 'Outfit', sans-serif;
    color: #1c1917;
  }

  .cp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .cp-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  /* Left Column: Gallery & Badges */
  .cp-gallery-wrapper {
    position: relative;
    width: 100%;
  }

  .cp-badge-left {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 10;
    background-color: #b88146;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 4px;
    letter-spacing: 0.03em;
  }

  .cp-badge-right {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 10;
    background: #f59e0b;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1.1;
    box-shadow: 0 4px 10px rgba(245, 158, 11, 0.3);
  }

  .cp-main-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    background-color: #ffffff;
    border: 1px solid #f2ece1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .cp-main-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 12px;
    box-sizing: border-box;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .cp-zoom-trigger {
    position: absolute;
    bottom: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #efe6d5;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .cp-thumbnails-container {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-width: thin;
  }

  .cp-thumb {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    border: 2px solid #efe6d5;
    background: #ffffff;
    cursor: pointer;
    overflow: hidden;
    flex-shrink: 0;
    transition: border-color 0.2s ease;
  }

  .cp-thumb.active, .cp-thumb:hover {
    border-color: #1c1917;
  }

  .cp-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 2px;
  }

  /* Right Column: Product Information */
  .cp-info {
    display: flex;
    flex-direction: column;
  }

  .cp-rating-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
    font-size: 0.9rem;
    color: #44403c;
  }

  .cp-stars {
    color: #d97706;
    letter-spacing: 1px;
  }

  .cp-rating-score {
    font-weight: 700;
  }

  .cp-rating-count {
    color: #78716c;
  }

  .cp-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.2;
    color: #1c1917;
    margin: 0 0 12px;
  }

  .cp-description-short {
    font-size: 0.92rem;
    line-height: 1.55;
    color: #57534e;
    margin-bottom: 20px;
    border-bottom: 1px solid #f2ece1;
    padding-bottom: 16px;
  }

  /* Pricing Row */
  .cp-mrp-label {
    font-size: 0.75rem;
    color: #78716c;
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .cp-price-container {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .cp-current-price {
    font-family: 'Myanmar MN', 'Myanmar Sangam MN', 'Cormorant Garamond', serif !important;
    font-size: 2rem;
    font-weight: 700;
    color: #1c1917;
  }

  .cp-compare-price {
    font-family: 'Myanmar MN', 'Myanmar Sangam MN', 'Cormorant Garamond', serif !important;
    font-size: 1.25rem;
    color: #a8a29e;
    text-decoration: line-through;
  }

  .cp-discount-badge {
    background-color: #fef3c7;
    color: #92400e;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
  }

  .cp-feature-pill {
    margin-left: auto;
    background-color: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Pick Your Size & Combos - Variant Cards */
  .cp-variant-section {
    margin-bottom: 28px;
  }

  .cp-variant-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 14px;
  }

  .cp-variant-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #1c1917;
    margin-bottom: 2px;
  }

  .cp-variant-subtitle {
    font-size: 0.84rem;
    color: #78716c;
  }

  .cp-variant-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 14px;
  }

  .cp-vcard {
    position: relative;
    background: #ffffff;
    border: 2px solid #efe6d5;
    border-radius: 14px;
    padding: 20px 12px 16px;
    cursor: pointer;
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cp-vcard:hover {
    border-color: #b88146;
    transform: translateY(-2px);
  }

  .cp-vcard.selected {
    border-color: #b88146;
    background-color: #fffdf9;
    box-shadow: 0 6px 16px rgba(184, 129, 70, 0.16);
  }

  .cp-vcard-top-tag {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #b88146;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 9px;
    border-radius: 4px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    z-index: 2;
  }

  .cp-vcard-img {
    width: 90px;
    height: 90px;
    max-width: 100%;
    object-fit: contain;
    margin-bottom: 10px;
    transition: transform 0.3s ease;
  }

  .cp-vcard:hover .cp-vcard-img {
    transform: scale(1.06);
  }

  .cp-vcard-name-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1c1917;
    margin-bottom: 4px;
    line-height: 1.2;
  }

  .cp-vcard-check {
    width: 14px;
    height: 14px;
    fill: #10b981;
    display: none;
    flex-shrink: 0;
  }

  .cp-vcard.selected .cp-vcard-check {
    display: inline-block;
  }

  .cp-vcard-size-tag {
    background: #f3f4f6;
    color: #4b5563;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 12px;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .cp-vcard-prices {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: auto;
  }

  .cp-vcard-compare {
    font-family: 'Myanmar MN', 'Myanmar Sangam MN', serif !important;
    font-size: 0.82rem;
    color: #a8a29e;
    text-decoration: line-through;
  }

  .cp-vcard-price {
    font-family: 'Myanmar MN', 'Myanmar Sangam MN', serif !important;
    font-size: 1.1rem;
    font-weight: 700;
    color: #1c1917;
  }

  /* Action Buttons */
  .cp-actions-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }

  /* Remove number spin buttons */
  input[type='number']::-webkit-outer-spin-button,
  input[type='number']::-webkit-inner-spin-button {
    -webkit-appearance: none !important;
    margin: 0 !important;
  }

  input[type='number'] {
    -moz-appearance: textfield !important;
    appearance: textfield !important;
  }

  .cp-qty-and-cart-row {
    display: flex;
    gap: 12px;
  }

  .cp-qty-box {
    display: flex;
    align-items: center;
    border: 1px solid #d6d3d1;
    border-radius: 6px;
    background: #fafaf9;
    height: 48px;
    padding: 0 4px;
  }

  .cp-qty-btn {
    width: 36px;
    height: 100%;
    border: none;
    background: none;
    font-size: 1.1rem;
    font-weight: 600;
    color: #44403c;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cp-qty-input {
    width: 36px;
    border: none;
    background: none;
    text-align: center;
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: #1c1917;
    outline: none;
    -webkit-appearance: none !important;
    -moz-appearance: textfield !important;
    appearance: textfield !important;
  }
  .cp-qty-input::-webkit-outer-spin-button,
  .cp-qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none !important;
    margin: 0 !important;
  }

  .cp-add-cart-btn {
    flex: 1;
    height: 48px;
    background-color: #000000;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .cp-add-cart-btn:hover {
    background-color: #1c1917;
  }

  .cp-buy-now-btn {
    width: 100%;
    height: 48px;
    background-color: #faf5ec;
    color: #1c1917;
    border: 1px solid #efe6d5;
    border-radius: 6px;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .cp-buy-now-btn:hover {
    background-color: #f5ebd9;
  }

  /* Trust Badges */
  .cp-trust-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    background: #fdfbf7;
    border: 1px solid #f3ebd9;
    border-radius: 8px;
    font-size: 0.85rem;
    color: #44403c;
  }

  .cp-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  .cp-trust-subtext {
    font-size: 0.8rem;
    color: #78716c;
    margin-left: 26px;
  }
</style>

<div class="cp-section" id="custom-product-{{ section.id }}">
  <div class="cp-grid">
    
    <!-- Left Column: Gallery & Badges -->
    <div class="cp-gallery-wrapper">
      {% if left_badge_val != blank %}
        <div class="cp-badge-left">{{ left_badge_val }}</div>
      {% endif %}

      {% if right_badge_val != blank %}
        <div class="cp-badge-right">{{ right_badge_val }}</div>
      {% else %}
        <div class="cp-badge-right">90<br>PYRAMID<br>BAGS</div>
      {% endif %}

      <div class="cp-main-media">
        <img 
          id="cp-featured-img" 
          src="{{ featured_media | image_url: width: 1000 }}" 
          alt="{{ featured_media.alt | default: product.title | escape }}"
        >
        <button type="button" class="cp-zoom-trigger" aria-label="Zoom Image">
          🔍
        </button>
      </div>

      <!-- Thumbnail Carousel -->
      {% if product.media.size > 1 %}
        <div class="cp-thumbnails-container">
          {% for media in product.media %}
            <div 
              class="cp-thumb {% if media.id == featured_media.id or forloop.first %}active{% endif %}" 
              data-img-url="{{ media | image_url: width: 1000 }}"
            >
              <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}">
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Right Column: Product Details & Pick Your Size -->
    <div class="cp-info">
      
      <!-- Rating -->
      <div class="cp-rating-row">
        <span class="cp-stars">★★★★★</span>
        <span class="cp-rating-score">{{ rating_val }}</span>
        <span class="cp-rating-count">({{ rating_count }})</span>
      </div>

      <!-- Title -->
      <h1 class="cp-title">{{ product.title }}</h1>

      <!-- Description / Subtitle -->
      <div class="cp-description-short">
        {% if product.description != blank %}
          {{ product.description | strip_html | truncatewords: 32 }}
        {% else %}
          Carefully blended with whole leaves, natural botanicals, and traditional spices to ease digestion and bring everyday comfort.
        {% endif %}
      </div>

      <!-- Price Block -->
      <div class="cp-mrp-label">MRP (incl. of all taxes)</div>
      <div class="cp-price-container">
        <span class="cp-current-price" id="cp-price-display">{{ current_variant.price | money_without_trailing_zeros }}</span>
        
        <span class="cp-compare-price" id="cp-compare-display" {% if current_variant.compare_at_price <= current_variant.price or current_variant.compare_at_price == blank %}style="display:none;"{% endif %}>
          {{ current_variant.compare_at_price | money_without_trailing_zeros }}
        </span>

        <span class="cp-discount-badge" id="cp-discount-display" {% if initial_discount <= 0 %}style="display:none;"{% endif %}>
          {{ initial_discount }}% OFF
        </span>

        <div class="cp-feature-pill">
          <span>🌱</span>
          <span>{{ section.settings.feature_pill_text | default: "Plant Based Plastic Free" }}</span>
        </div>
      </div>

      <!-- Pick Your Size & Combos - Variant Cards -->
      <div class="cp-variant-section">
        <div class="cp-variant-header">
          <div class="cp-variant-title">{{ section.settings.variant_heading | default: "Pick Your Size & Combo" }}</div>
          <div class="cp-variant-subtitle">{{ section.settings.variant_subheading | default: "Select your favorite variant or combo pack for your wellness goal." }}</div>
        </div>

        <div class="cp-variant-cards-grid">
          {% if section.blocks.size > 0 %}
            
            <!-- Custom JSON Configured Cards -->
            {% for block in section.blocks %}
              {% assign card_v_id = block.settings.variant_id %}
              {% if card_v_id == blank and product.variants.size > forloop.index0 %}
                {% assign card_v_id = product.variants[forloop.index0].id %}
              {% endif %}
              {% if card_v_id == blank %}
                {% assign card_v_id = current_variant.id %}
              {% endif %}

              {% assign card_media = featured_media %}
              {% if product.media.size > forloop.index0 %}
                {% assign card_media = product.media[forloop.index0] %}
              {% endif %}

              <div 
                class="cp-vcard {% if forloop.first %}selected{% endif %}" 
                data-variant-id="{{ card_v_id }}"
                data-price="{{ block.settings.price | default: current_variant.price | money_without_trailing_zeros }}"
                data-compare="{{ block.settings.compare_price | default: current_variant.compare_at_price | money_without_trailing_zeros }}"
                data-discount="{{ block.settings.discount | default: initial_discount | append: '% OFF' }}"
                data-img="{% if block.settings.card_image != blank %}{{ block.settings.card_image | image_url: width: 1000 }}{% else %}{{ card_media | image_url: width: 1000 }}{% endif %}"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.top_tag != blank %}
                  <div class="cp-vcard-top-tag">{{ block.settings.top_tag }}</div>
                {% endif %}

                {% if block.settings.card_image != blank %}
                  <img src="{{ block.settings.card_image | image_url: width: 300 }}" class="cp-vcard-img" alt="{{ block.settings.title }}">
                {% else %}
                  <img src="{{ card_media | image_url: width: 300 }}" class="cp-vcard-img" alt="{{ block.settings.title }}">
                {% endif %}

                <div class="cp-vcard-name-row">
                  <span>{{ block.settings.title }}</span>
                  <svg class="cp-vcard-check" viewBox="0 0 20 20"><path d="M0 11l2-2 5 5L18 3l2 2L7 18z"/></svg>
                </div>

                {% if block.settings.size_tag != blank %}
                  <div class="cp-vcard-size-tag">{{ block.settings.size_tag }}</div>
                {% endif %}

                <div class="cp-vcard-prices">
                  {% if block.settings.compare_price != blank %}
                    <span class="cp-vcard-compare">{{ block.settings.compare_price }}</span>
                  {% endif %}
                  <span class="cp-vcard-price">{{ block.settings.price }}</span>
                </div>
              </div>
            {% endfor %}

          {% elsif product.has_only_default_variant or product.variants.size <= 1 %}
            
            <!-- Default Demo Cards (Transformation, Progress, Starter Pack) -->
            <div 
              class="cp-vcard selected" 
              data-variant-id="{{ current_variant.id }}"
              data-price="{{ current_variant.price | money_without_trailing_zeros }}"
              data-compare="{{ current_variant.compare_at_price | money_without_trailing_zeros }}"
              data-discount="{{ initial_discount }}% OFF"
              data-img="{{ featured_media | image_url: width: 1000 }}"
            >
              <div class="cp-vcard-top-tag">BEST VALUE</div>
              <img src="{{ featured_media | image_url: width: 300 }}" class="cp-vcard-img" alt="Transformation Pack">
              <div class="cp-vcard-name-row">
                <span>Transformation</span>
                <svg class="cp-vcard-check" viewBox="0 0 20 20"><path d="M0 11l2-2 5 5L18 3l2 2L7 18z"/></svg>
              </div>
              <div class="cp-vcard-size-tag">30 DAY KIT / 1 KG</div>
              <div class="cp-vcard-prices">
                <span class="cp-vcard-compare">{{ current_variant.compare_at_price | money_without_trailing_zeros }}</span>
                <span class="cp-vcard-price">{{ current_variant.price | money_without_trailing_zeros }}</span>
              </div>
            </div>

            {% assign media_2 = product.media[1] | default: featured_media %}
            <div 
              class="cp-vcard" 
              data-variant-id="{{ current_variant.id }}"
              data-price="₹849"
              data-compare="₹999"
              data-discount="15% OFF"
              data-img="{{ media_2 | image_url: width: 1000 }}"
            >
              <img src="{{ media_2 | image_url: width: 300 }}" class="cp-vcard-img" alt="Progress Pack">
              <div class="cp-vcard-name-row">
                <span>Progress</span>
                <svg class="cp-vcard-check" viewBox="0 0 20 20"><path d="M0 11l2-2 5 5L18 3l2 2L7 18z"/></svg>
              </div>
              <div class="cp-vcard-size-tag">20 DAY KIT / 500G</div>
              <div class="cp-vcard-prices">
                <span class="cp-vcard-compare">₹999</span>
                <span class="cp-vcard-price">₹849</span>
              </div>
            </div>

            {% assign media_3 = product.media[2] | default: featured_media %}
            <div 
              class="cp-vcard" 
              data-variant-id="{{ current_variant.id }}"
              data-price="₹449"
              data-compare="₹499"
              data-discount="10% OFF"
              data-img="{{ media_3 | image_url: width: 1000 }}"
            >
              <img src="{{ media_3 | image_url: width: 300 }}" class="cp-vcard-img" alt="Starter Pack">
              <div class="cp-vcard-name-row">
                <span>Starter Pack</span>
                <svg class="cp-vcard-check" viewBox="0 0 20 20"><path d="M0 11l2-2 5 5L18 3l2 2L7 18z"/></svg>
              </div>
              <div class="cp-vcard-size-tag">10 DAY KIT / 250G</div>
              <div class="cp-vcard-prices">
                <span class="cp-vcard-compare">₹499</span>
                <span class="cp-vcard-price">₹449</span>
              </div>
            </div>

          {% else %}

            <!-- Dynamic Multi-Variant Loop Parsing Sizes & Combos -->
            {% for variant in product.variants %}
              {% assign v_discount = 0 %}
              {% if variant.compare_at_price > variant.price %}
                {% assign v_discount = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price %}
              {% endif %}
              {% assign v_img = variant.featured_media | default: featured_media %}
              
              {% comment %} Parse Size & Combo Tag {% endcomment %}
              {% assign v_title_dc = variant.title | downcase %}
              {% assign size_tag_str = '' %}
              {% if v_title_dc contains 'combo' or v_title_dc contains 'pack' or v_title_dc contains 'pair' or v_title_dc contains 'set' %}
                {% assign size_tag_str = 'COMBO PACK' %}
              {% elsif variant.weight >= 1000 %}
                {% assign size_tag_str = variant.weight | divided_by: 1000.0 | round: 1 | append: ' KG' %}
              {% elsif variant.weight > 0 %}
                {% assign size_tag_str = variant.weight | append: 'G' %}
              {% else %}
                {% assign size_tag_str = variant.title | upcase %}
              {% endif %}

              <div 
                class="cp-vcard {% if variant.id == current_variant.id or forloop.first %}selected{% endif %}" 
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price | money_without_trailing_zeros }}"
                data-compare="{{ variant.compare_at_price | money_without_trailing_zeros }}"
                data-discount="{{ v_discount }}% OFF"
                data-img="{{ v_img | image_url: width: 1000 }}"
              >
                {% if forloop.first %}
                  <div class="cp-vcard-top-tag">BEST VALUE</div>
                {% elsif v_discount >= 20 %}
                  <div class="cp-vcard-top-tag">SAVE {{ v_discount }}%</div>
                {% endif %}

                <img src="{{ v_img | image_url: width: 300 }}" class="cp-vcard-img" alt="{{ variant.title }}">
                <div class="cp-vcard-name-row">
                  <span>{{ variant.title }}</span>
                  <svg class="cp-vcard-check" viewBox="0 0 20 20"><path d="M0 11l2-2 5 5L18 3l2 2L7 18z"/></svg>
                </div>

                <div class="cp-vcard-size-tag">{{ size_tag_str }}</div>

                <div class="cp-vcard-prices">
                  <span class="cp-vcard-compare" {% if variant.compare_at_price <= variant.price or variant.compare_at_price == blank %}style="display:none;"{% endif %}>{{ variant.compare_at_price | money_without_trailing_zeros }}</span>
                  <span class="cp-vcard-price">{{ variant.price | money_without_trailing_zeros }}</span>
                </div>
              </div>
            {% endfor %}

          {% endif %}
        </div>
      </div>

      <!-- Action Form -->
      <form class="cp-actions-form" id="cp-product-form">
        <input type="hidden" name="id" id="cp-variant-id-input" value="{{ current_variant.id }}">
        
        <div class="cp-qty-and-cart-row">
          <div class="cp-qty-box">
            <button type="button" class="cp-qty-btn" id="cp-qty-minus">-</button>
            <input type="number" name="quantity" id="cp-qty-input" value="1" min="1" class="cp-qty-input">
            <button type="button" class="cp-qty-btn" id="cp-qty-plus">+</button>
          </div>

          <button type="submit" class="cp-add-cart-btn" id="cp-add-cart-btn">
            Add To Cart
          </button>
        </div>

        <button type="button" class="cp-buy-now-btn" id="cp-buy-now-btn">
          Buy Now
        </button>
      </form>

      <!-- Trust Badges -->
      <div class="cp-trust-box">
        <div class="cp-trust-item">
          <span>🚚</span>
          <span>{{ section.settings.shipping_text | default: "Free shipping above ₹499 | Express Delivery across the country." }}</span>
        </div>
        <div class="cp-trust-subtext">
          {{ section.settings.trust_text | default: "Trusted by 50 lakh+ customers worldwide." }}
        </div>
      </div>

    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionContainer = document.getElementById('custom-product-{{ section.id }}');
    if (!sectionContainer) return;

    const mainImg = sectionContainer.querySelector('#cp-featured-img');
    const priceDisplay = sectionContainer.querySelector('#cp-price-display');
    const compareDisplay = sectionContainer.querySelector('#cp-compare-display');
    const discountDisplay = sectionContainer.querySelector('#cp-discount-display');
    const variantInput = sectionContainer.querySelector('#cp-variant-id-input');
    const thumbnails = sectionContainer.querySelectorAll('.cp-thumb');
    const vcards = sectionContainer.querySelectorAll('.cp-vcard');
    const qtyInput = sectionContainer.querySelector('#cp-qty-input');
    const qtyMinus = sectionContainer.querySelector('#cp-qty-minus');
    const qtyPlus = sectionContainer.querySelector('#cp-qty-plus');
    const addCartBtn = sectionContainer.querySelector('#cp-add-cart-btn');
    const buyNowBtn = sectionContainer.querySelector('#cp-buy-now-btn');

    // Thumbnail Clicks
    thumbnails.forEach(thumb => {
      thumb.addEventListener('click', function() {
        thumbnails.forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        const newImgUrl = this.getAttribute('data-img-url');
        if (mainImg && newImgUrl) {
          mainImg.style.opacity = '0.3';
          setTimeout(() => {
            mainImg.src = newImgUrl;
            mainImg.style.opacity = '1';
          }, 120);
        }
      });
    });

    // Variant / Combo Card Clicks
    vcards.forEach(card => {
      card.addEventListener('click', function() {
        vcards.forEach(c => c.classList.remove('selected'));
        this.classList.add('selected');

        const variantId = this.getAttribute('data-variant-id');
        const price = this.getAttribute('data-price');
        const compare = this.getAttribute('data-compare');
        const discount = this.getAttribute('data-discount');
        const imgUrl = this.getAttribute('data-img');

        // Update form variant ID for correct checkout price
        if (variantInput && variantId) {
          variantInput.value = variantId;
        }

        // Update prices
        if (priceDisplay && price) priceDisplay.textContent = price;

        if (compareDisplay) {
          if (compare && compare !== price) {
            compareDisplay.textContent = compare;
            compareDisplay.style.display = 'inline';
          } else {
            compareDisplay.style.display = 'none';
          }
        }

        if (discountDisplay) {
          if (discount && discount !== '0% OFF') {
            discountDisplay.textContent = discount;
            discountDisplay.style.display = 'inline-block';
          } else {
            discountDisplay.style.display = 'none';
          }
        }

        // Update main preview image & sync thumbnail highlight
        if (mainImg && imgUrl) {
          mainImg.style.opacity = '0.3';
          setTimeout(() => {
            mainImg.src = imgUrl;
            mainImg.style.opacity = '1';
          }, 120);

          thumbnails.forEach(thumb => {
            const thumbUrl = thumb.getAttribute('data-img-url');
            if (thumbUrl && (thumbUrl === imgUrl || imgUrl.includes(thumbUrl.split('?')[0]))) {
              thumbnails.forEach(t => t.classList.remove('active'));
              thumb.classList.add('active');
            }
          });
        }
      });
    });

    // Quantity Stepper
    if (qtyMinus && qtyInput) {
      qtyMinus.addEventListener('click', function() {
        let currentVal = parseInt(qtyInput.value) || 1;
        if (currentVal > 1) {
          qtyInput.value = currentVal - 1;
        }
      });
    }

    if (qtyPlus && qtyInput) {
      qtyPlus.addEventListener('click', function() {
        let currentVal = parseInt(qtyInput.value) || 1;
        qtyInput.value = currentVal + 1;
      });
    }

    // Add to Cart Submit
    const form = sectionContainer.querySelector('#cp-product-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        const originalText = addCartBtn.innerHTML;
        addCartBtn.innerHTML = 'Adding...';

        const formData = new FormData(form);

        fetch('/cart/add.js', {
          method: 'POST',
          body: formData,
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(data => {
          addCartBtn.innerHTML = '✓ Added to Cart';
          addCartBtn.style.backgroundColor = '#15803d';
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));

          setTimeout(() => {
            addCartBtn.innerHTML = originalText;
            addCartBtn.style.backgroundColor = '';
          }, 1800);
        })
        .catch(err => {
          console.error(err);
          addCartBtn.innerHTML = originalText;
        });
      });
    }

    // Buy Now Handler
    if (buyNowBtn && form) {
      buyNowBtn.addEventListener('click', function() {
        const formData = new FormData(form);
        fetch('/cart/add.js', {
          method: 'POST',
          body: formData,
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(() => {
          window.location.href = '/checkout';
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Custom Product Details",
  "settings": [
    { "type": "text", "id": "variant_heading", "label": "Variant Section Heading", "default": "Pick Your Size & Combo" },
    { "type": "text", "id": "variant_subheading", "label": "Variant Section Subheading", "default": "Select your favorite variant or combo pack for your wellness goal." },
    { "type": "text", "id": "feature_pill_text", "label": "Feature Pill Badge Text", "default": "Plant Based Plastic Free" },
    { "type": "text", "id": "left_badge_text", "label": "Left Top Badge Text", "default": "New Launch" },
    { "type": "text", "id": "right_badge_text", "label": "Right Circular Badge Text", "default": "90 PYRAMID BAGS" },
    { "type": "text", "id": "shipping_text", "label": "Shipping Trust Text", "default": "Free shipping above ₹499 | Express Delivery across the country." },
    { "type": "text", "id": "trust_text", "label": "Customer Trust Text", "default": "Trusted by 50 lakh+ customers worldwide." }
  ],
  "blocks": [
    {
      "type": "custom_card",
      "name": "Size / Combo Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Card Title", "default": "Transformation Pack" },
        { "type": "text", "id": "size_tag", "label": "Size / Combo Badge", "default": "30 DAY KIT / 1 KG" },
        { "type": "text", "id": "top_tag", "label": "Top Badge (e.g. BEST VALUE)", "default": "BEST VALUE" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹1,199" },
        { "type": "text", "id": "compare_price", "label": "Compare Price", "default": "₹1,499" },
        { "type": "text", "id": "discount", "label": "Discount Percentage", "default": "20" },
        { "type": "image_picker", "id": "card_image", "label": "Card Image" },
        { "type": "text", "id": "variant_id", "label": "Variant ID (Optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Details"
    }
  ]
}
{% endschema %}
